# Google Keep API Credentials
GOOGLE_EMAIL=your-email@gmail.com
GOOGLE_MASTER_TOKEN=your-master-token-see-the-readme-on-how-to-get-it

# Docker / Compose (optional): path to a file holding the master token.
# The compose file mounts it read-only into the container instead of using
# GOOGLE_MASTER_TOKEN above. This holds the token file *path*, never the
# token itself — keep the actual token in that file (chmod 600).
# TOKEN_FILE_HOST=/home/you/.config/keep-mcp/google_master_token
# UNSAFE_MODE=false

# Bitwarden Secrets Manager (optional): used by scripts/run-with-bitwarden.sh
# instead of TOKEN_FILE_HOST above. The secret ID is only an identifier, safe
# here; the access token itself stays in its own chmod-600 file, never in .env.
# BWS_SECRET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# BWS_TOKEN_FILE=/home/you/.config/keep-mcp/bws-token